@page "/staff/queue"
@attribute [Authorize(Roles = "Staff")]
@inject TicketService Tickets

<div class="page-head">
    <div>
        <h1>Ticket Queue</h1>
        <p>View active requests. Open a ticket to update its status.</p>
    </div>
</div>
<TicketTable Tickets='Tickets.Tickets.Where(t => t.Status != "Resolved" && t.Status != "Closed")' />

@page "/staff/assigned"
@attribute [Authorize(Roles = "Staff")]
@inject TicketService Tickets
@inject AuthenticationStateProvider Authentication

<div class="page-head"><div><h1>My Assigned Tickets</h1><p>Tickets currently assigned to you.</p></div></div>
@if (staff is null)
{
    <div class="card empty" role="status">Loading assigned tickets…</div>
}
else
{
    <TicketTable Tickets="Tickets.GetAssignedTickets(staff)" />
}

@code {
    private System.Security.Claims.ClaimsPrincipal? staff;
    protected override async Task OnInitializedAsync()
    {
        staff = (await Authentication.GetAuthenticationStateAsync()).User;
    }
}

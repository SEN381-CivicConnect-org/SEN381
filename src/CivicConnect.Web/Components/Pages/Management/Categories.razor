@page "/management/categories"
@attribute [Authorize(Roles = "Management")]
@inject WorkspaceDataService Data
@inject ILogger<Categories> Logger

<div class="page-head"><div><h1>Categories</h1><p>Service categories, including inactive categories. Categories are read-only.</p></div></div>
@if (error is not null)
{
    <div class="card empty" role="status">@error</div>
}
else if (categories is null)
{
    <div class="card empty" role="status">Loading categories…</div>
}
else if (categories.Count == 0)
{
    <div class="card empty" role="status">No service categories are configured.</div>
}
else
{
    <div class="grid grid-2">
        @foreach (var category in categories)
        {
            <div class="card settings-card category-card">
                <div class="category-card-head">
                    <h4>@category.Name</h4>
                    <span class="badge @(category.IsActive ? "badge-resolved" : "badge-closed")">@(category.IsActive ? "Active" : "Inactive")</span>
                </div>
                <p>@category.Description</p>
            </div>
        }
    </div>
}

@code {
    private List<DirectoryCategory>? categories;
    private string? error;
    protected override async Task OnInitializedAsync()
    {
        try { categories = await Data.GetCategoriesAsync(); }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unable to load service categories.");
            error = "Service categories are currently unavailable.";
        }
    }
}

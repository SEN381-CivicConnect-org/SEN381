@attribute [Authorize(Roles = "Requester")]
@page "/requester/tickets"
@inject TicketService Tickets
@inject AuthenticationStateProvider AuthState
@inject WorkspaceNavigation Workspace

<PageTitle>My Tickets | CivicConnect</PageTitle>
<div class="page-head">
    <div>
        <p class="eyebrow">Requester workspace</p>
        <h1>My Tickets</h1>
        <p>View and track every request you have submitted.</p>
    </div>
    <button
        class="btn btn-primary"
        @onclick='() => Nav.NavigateTo("/requester/new")'>New Ticket</button>
</div>
<div class="filters">
    @foreach (var f in new[] { "All", "Open", "In Progress", "Resolved" })
    {
        <button
            class="filter-btn @(filter == f ? "active" : "")"
            @onclick="() => filter = f">@f</button>
    }
</div>
<TicketTable Tickets="Filtered" />

@code
{
    string filter
    {
        get => Workspace.RequesterFilter;
        set => Workspace.RequesterFilter = value;
    }

    IEnumerable<Ticket> history = Array.Empty<Ticket>();

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthState.GetAuthenticationStateAsync();
        history = Tickets.GetReporterHistory(state.User);
    }

    IEnumerable<Ticket> Filtered => history.Where(t => filter == "All" || t.Status == filter);
}

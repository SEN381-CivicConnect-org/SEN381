@page "/requester/new"
@attribute [Authorize(Roles = "Requester")]
@inject TicketService Tickets
@inject NavigationManager Nav
@using CivicConnect.Domain.Entities
@using CivicConnect.Domain.Enums

<PageTitle>New Ticket | CivicConnect</PageTitle>

<div class="page-head">
    <div>
        <p class="eyebrow">New service request</p>
        <h1>Create a new ticket</h1>
        <p>Provide enough detail for the correct team to understand and resolve your request.</p>
    </div>
</div>

<div class="card form-card">
    <form @onsubmit="Submit">
        <div class="form-grid">
            <div class="field full">
                <label for="ticket-title">Request title *</label>
                <input id="ticket-title" @bind="model.Title" placeholder="e.g. Electrical sparks in ground floor hallway" required />
            </div>

            <div class="field">
                <label for="ticket-category">Category *</label>
                <select id="ticket-category" @bind="SelectedCategory" required>
                    <option value="">Select a category</option>
                    @foreach (var cat in availableCategories)
                    {
                        <option value="@cat.Name">@cat.Name (@cat.Urgency Urgency)</option>
                    }
                </select>
                <small>Categories and default urgency levels are managed dynamically via PostgreSQL.</small>
            </div>

            <div class="field">
                <label for="ticket-impact">Reported Location Impact *</label>
                <select id="ticket-impact" @bind="SelectedImpact" required>
                    <option value="@ImpactLevel.High">High Impact (Campus / Building / Critical Facility)</option>
                    <option value="@ImpactLevel.Medium">Medium Impact (Ground Floor / Public Area / Department)</option>
                    <option value="@ImpactLevel.Low">Low Impact (Single Workstation / Specific Room)</option>
                </select>
                <small>Select the physical scope affected by this request.</small>
            </div>

            <!-- FR-05 Rich Domain Model Calculated Priority Preview -->
            <div class="field full" style="background: var(--surface-subtle, #f8fafc); border: 1px solid var(--border); border-radius: 8px; padding: 14px 16px;">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
                    <div>
                        <div style="font-weight: 600; font-size: 13.5px; color: var(--text);">
                            Calculated Priority:
                            <span class="badge @GetPriorityBadgeClass(previewRequest.Priority)" style="margin-left: 8px; font-size: 12px; padding: 4px 10px;">
                                @previewRequest.Priority Priority
                            </span>
                        </div>
                        <div style="font-size: 12px; color: var(--muted); margin-top: 4px;">
                            Encapsulated Domain Model (FR-05): Category Urgency <strong>@previewRequest.Urgency</strong> + Location Impact <strong>@previewRequest.Impact</strong>.
                        </div>
                    </div>
                    <span style="font-size: 11px; padding: 3px 8px; background: #e0e7ff; color: #3730a3; border-radius: 4px; font-weight: 600;">
                        STK-CFL-01 Enforced
                    </span>
                </div>
            </div>

            <div class="field full">
                <label for="ticket-desc">Description *</label>
                <textarea id="ticket-desc" @bind="model.Description" rows="4" placeholder="Describe the problem, specific location, and any immediate hazards." required></textarea>
            </div>

            <div class="field full">
                <label>Attachment</label>
                <div class="attachment-area">
                    <div>
                        <strong>Deferred capability</strong>
                        <span>Attachments are present in the visual mockup but are not in the current committed scope.</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="form-actions">
            <button
                type="button"
                class="btn btn-secondary"
                @onclick='() => Nav.NavigateTo("/requester/tickets")'>Cancel</button>
            <button class="btn btn-primary" type="submit">Submit Ticket</button>
        </div>
    </form>
</div>

@code {
    private record CategoryOption(string Name, UrgencyLevel Urgency);

    private readonly List<CategoryOption> availableCategories = new()
    {
        new("Electrical", UrgencyLevel.Critical),
        new("Safety Incident", UrgencyLevel.Critical),
        new("IT Support", UrgencyLevel.High),
        new("Facilities", UrgencyLevel.Medium),
        new("HR Request", UrgencyLevel.Low),
        new("Finance", UrgencyLevel.Low),
        new("General Enquiry", UrgencyLevel.Low)
    };

    private Ticket model = new();
    private ServiceRequest previewRequest = new();

    private string selectedCategory = "Facilities";
    private string SelectedCategory
    {
        get => selectedCategory;
        set
        {
            selectedCategory = value;
            Recalculate();
        }
    }

    private ImpactLevel selectedImpact = ImpactLevel.Medium;
    private ImpactLevel SelectedImpact
    {
        get => selectedImpact;
        set
        {
            selectedImpact = value;
            Recalculate();
        }
    }

    protected override void OnInitialized()
    {
        Recalculate();
    }

    private void Recalculate()
    {
        var matched = availableCategories.FirstOrDefault(c => c.Name == selectedCategory) 
                      ?? new CategoryOption("Facilities", UrgencyLevel.Medium);
        
        previewRequest.SetImpactAndUrgency(selectedImpact, matched.Urgency);
    }

    private string GetPriorityBadgeClass(PriorityLevel priority) => priority switch
    {
        PriorityLevel.Critical => "badge-critical",
        PriorityLevel.High => "badge-high",
        PriorityLevel.Medium => "badge-medium",
        _ => "badge-low"
    };

    private void Submit()
    {
        var matched = availableCategories.FirstOrDefault(c => c.Name == selectedCategory) 
                      ?? new CategoryOption("Facilities", UrgencyLevel.Medium);

        model.Category = selectedCategory;
        model.Impact = selectedImpact;
        model.Urgency = matched.Urgency;

        var id = Tickets.Create(model);
        Nav.NavigateTo($"/tickets/{id}");
    }
}

@page "/requester/new"
@attribute [Authorize(Roles="Requester")]
@inject TicketService Tickets
@inject AuthenticationStateProvider Authentication
<PageTitle>New Ticket | CivicConnect</PageTitle><div class="page-head"><div><p class="eyebrow">New service request</p><h1>Create a new ticket</h1><p>Provide enough detail for the correct team to understand and resolve your request.</p></div></div><div class="card form-card"><form @onsubmit="Submit" @onsubmit:preventDefault="true"><div class="form-grid"><div class="field full"><label>Request title *</label><input @bind="model.Title" required/></div><div class="field"><label>Category *</label><select @bind="model.Category" required><option value="">Select a category</option><option>IT Support</option><option>Facilities</option><option>HR Request</option><option>Finance</option><option>General Enquiry</option></select><small>Categories are configured by your office.</small></div><div class="field"><label>Priority *</label><select @bind="model.Priority"><option>Low</option><option>Medium</option><option>High</option></select></div><div class="field full"><label>Description *</label><textarea @bind="model.Description" required></textarea></div><div class="field full"><label>Attachment</label><div class="attachment-area"><div><strong>Deferred capability</strong><span>Attachments are present in the visual mockup but are not in the current committed scope.</span></div></div></div></div><div class="form-actions"><button type="button" class="btn btn-secondary" @onclick='()=>Nav.NavigateTo("/requester/tickets")'>Cancel</button><button class="btn btn-primary" type="submit">Submit Ticket</button></div></form></div>
@code
{
    Ticket model = new() { Priority = "Medium" };

    async Task Submit()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var id = Tickets.Create(model, state.User);
        Nav.NavigateTo($"/tickets/{id}");
    }
}

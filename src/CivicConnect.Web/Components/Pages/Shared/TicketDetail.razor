@page "/tickets/{Id}"
@attribute [Authorize]
@inject TicketService Tickets
@inject WorkspaceNavigation Workspace
@inject AuthenticationStateProvider Authentication

@if (ticket is null)
{
    <PageTitle>Ticket not found | CivicConnect</PageTitle>
    <div class="page-head">
        <div>
            <h1>Ticket not found</h1>
            <p>This ticket is unavailable. Return to your workspace to choose another ticket.</p>
        </div>
    </div>
    <button type="button" class="btn btn-primary" @onclick="Workspace.GoBack">Return to my workspace</button>
}
else
{
    <div class="page-head">
        <div>
            <button class="btn btn-ghost" @onclick="Workspace.GoBack">Back</button>
            <h1 style="margin-top:8px">@ticket.Title</h1>
            <p>#@ticket.Id · @ticket.Category</p>
        </div>
        <span class="badge">@ticket.Status</span>
    </div>
    <div class="detail-grid">
        <div class="card detail-card">
            <div class="meta-grid">
                <div class="meta-item">
                    <span>Requester</span>
                    <strong>@ticket.Requester</strong>
                </div>
                <div class="meta-item">
                    <span>Assigned to</span>
                    <strong>@ticket.Assignee</strong>
                </div>
                <div class="meta-item">
                    <span>Priority</span>
                    <strong>@ticket.Priority</strong>
                </div>
                <div class="meta-item">
                    <span>Last updated</span>
                    <strong>@ticket.Updated</strong>
                </div>
            </div>
            <div class="description">
                <strong>Description</strong>
                <p>@ticket.Description</p>
            </div>
            <div class="section-head" style="margin-top:28px">
                <h2>Activity</h2>
            </div>
            <div class="timeline">
                @foreach (var note in notes)
                {
                    <div class="timeline-item">
                        <div class="dot"></div>
                        <div>
                            <strong>@(note.IsInternal ? "Internal note" : "Public note")</strong>
                            <p style="white-space:pre-wrap;overflow-wrap:anywhere">@note.Text</p>
                            <p>@note.Timestamp.ToLocalTime().ToString("d MMM yyyy, HH:mm zzz") · @note.Author</p>
                        </div>
                    </div>
                }
                <div class="timeline-item">
                    <div class="dot"></div>
                    <div>
                        <strong>Status: @ticket.Status</strong>
                        <p>@ticket.Updated · System activity</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="dot"></div>
                    <div>
                        <strong>Ticket created</strong>
                        <p>Request submitted by @ticket.Requester.</p>
                    </div>
                </div>
            </div>
            @if (canAddNotes)
            {
                <form @onsubmit="AddNote" @onsubmit:preventDefault="true">
                    <div class="field">
                        <label for="ticket-note">Add a note</label>
                        <textarea id="ticket-note" @bind="noteText" required></textarea>
                    </div>
                    <div class="field">
                        <label for="note-visibility">Visibility</label>
                        <select id="note-visibility" @bind="isInternal">
                            <option value="true">Internal (staff and management)</option>
                            <option value="false">Public (visible to requester)</option>
                        </select>
                    </div>
                    @if (noteError is not null)
                    {
                        <p class="validation-message" role="alert">@noteError</p>
                    }
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Add note</button>
                    </div>
                </form>
            }
        </div>
        <div class="side-stack">
            <div class="card side-card">
                <h3>Ticket information</h3>
                <div class="kv">
                    <span>Ticket ID</span>
                    <strong>@ticket.Id</strong>
                </div>
                <div class="kv">
                    <span>Category</span>
                    <strong>@ticket.Category</strong>
                </div>
                <div class="kv">
                    <span>Priority</span>
                    <strong>@ticket.Priority</strong>
                </div>
                <div class="kv">
                    <span>Status</span>
                    <strong>@ticket.Status</strong>
                </div>
            </div>
        </div>
    </div>
}

@code
{
    [Parameter]
    public string Id { get; set; } = "";

    Ticket? ticket;
    IReadOnlyList<TicketNote> notes = Array.Empty<TicketNote>();
    string noteText = "";
    string? noteError;
    bool isInternal = true;
    bool canAddNotes;

    protected override async Task OnParametersSetAsync()
    {
        ticket = Tickets.Find(Id);
        noteText = "";
        noteError = null;
        isInternal = true;
        await LoadNotes();
    }

    async Task LoadNotes()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        canAddNotes = user.Identity?.IsAuthenticated == true &&
            (user.IsInRole("Staff") || user.IsInRole("Management"));
        notes = Tickets.GetNotes(Id, user);
    }

    async Task AddNote()
    {
        noteError = null;
        if (string.IsNullOrWhiteSpace(noteText))
        {
            noteError = "Enter a note before saving.";
            return;
        }

        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        try
        {
            Tickets.AddNote(Id, noteText, isInternal, user);
            noteText = "";
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException)
        {
            noteError = ex.Message;
        }
        await LoadNotes();
    }
}

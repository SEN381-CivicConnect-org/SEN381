@page "/tickets/{Id}"
@inject TicketService Tickets
@inject WorkspaceNavigation Workspace
@inject AuthenticationStateProvider Authentication

@if (ticket is null)
{
    <div class="card empty">
        <span class="badge">Ticket</span>
        <h2>Ticket not found</h2>
        <p>The ticket you selected is not available in the demo dataset.</p>
        <div class="form-actions" style="justify-content:center">
            <button class="btn btn-primary" @onclick="Workspace.GoBack">Back to dashboard</button>
        </div>
    </div>
}
else
{
    <PageTitle>#@ticket.Id @ticket.Title | CivicConnect</PageTitle>

    <div class="page-head">
        <div>
            <button type="button" class="btn btn-ghost btn-back" @onclick="Workspace.GoBack">← Back</button>
            <h1 class="detail-heading">@ticket.Title</h1>
            <p>#@ticket.Id · @ticket.Category · @ticket.Location</p>
        </div>
        <div class="page-head-badges">
            <span class="badge @PriorityMatrix.GetPriorityBadgeClass(ticket.PriorityId)">@ticket.Priority Priority</span>
            <span class="badge @GetStatusBadgeClass(ticket.Status)">@ticket.Status</span>
        </div>
    </div>

    <div class="detail-grid">
        <div class="card detail-card">
            <div class="meta-grid">
                <div class="meta-item">
                    <span>Requester</span>
                    <strong>@ticket.Requester</strong>
                </div>
                <div class="meta-item">
                    <span>Assigned to</span>
                    <strong>@ticket.Assignee</strong>
                </div>
                <div class="meta-item">
                    <span>Created</span>
                    <strong>@ticket.Created</strong>
                </div>
                <div class="meta-item">
                    <span>Updated</span>
                    <strong>@ticket.Updated</strong>
                </div>
            </div>

            <!-- FR-05 Priority Calculation Snapshot Breakdown -->
            <div class="priority-snapshot-card">
                <div class="priority-snapshot-head">
                    <span>Priority Calculation Snapshot (FR-05 / STK-CFL-01)</span>
                    <small>PriorityMatrix (DD-02)</small>
                </div>
                <div class="priority-snapshot-grid">
                    <div class="meta-item">
                        <span>Location Impact</span>
                        <strong>@ticket.ImpactName Impact (Level @ticket.ImpactLevel)</strong>
                    </div>
                    <div class="meta-item">
                        <span>Category Urgency</span>
                        <strong>@ticket.UrgencyName Urgency (Level @ticket.UrgencyLevel)</strong>
                    </div>
                    <div class="meta-item">
                        <span>Calculated Priority</span>
                        <strong>@ticket.Priority (Target #@ticket.PriorityId)</strong>
                    </div>
                </div>
            </div>

            <div class="description">
                <strong>Description</strong>
                <p>@ticket.Description</p>
            </div>

            <div class="section-head detail-section-head">
                <h2>Activity</h2>
            </div>
            <div class="timeline">
                @foreach (var entry in ticket.StatusHistory.AsEnumerable().Reverse())
                {
                    <div class="timeline-item">
                        <div class="dot"></div>
                        <div>
                            <strong>@entry.PreviousStatus → @entry.NewStatus</strong>
                            <p>@entry.Actor · @entry.ChangedAt.ToString("u")</p>
                        </div>
                    </div>
                }
                @foreach (var note in notes)
                {
                    <div class="timeline-item">
                        <div class="dot"></div>
                        <div>
                            <strong>@(note.IsInternal ? "Internal note" : "Public note")</strong>
                            <p class="note-body">@note.Text</p>
                            <p>@note.Timestamp.ToLocalTime().ToString("d MMM yyyy, HH:mm zzz") · @note.Author</p>
                        </div>
                    </div>
                }
                <div class="timeline-item">
                    <div class="dot"></div>
                    <div>
                        <strong>Status: @ticket.Status</strong>
                        <p>Assigned to @ticket.Assignee · Updated @ticket.Updated</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="dot"></div>
                    <div>
                        <strong>Ticket created with Priority: @ticket.Priority</strong>
                        <p>Request submitted by @ticket.Requester (Impact: @ticket.ImpactName [@ticket.ImpactLevel], Urgency: @ticket.UrgencyName [@ticket.UrgencyLevel]).</p>
                    </div>
                </div>
            </div>
            @if (canAddNotes)
            {
                <form class="note-form" @onsubmit="AddNote" @onsubmit:preventDefault="true">
                    <div class="field">
                        <label for="ticket-note">Add a note</label>
                        <textarea id="ticket-note" @bind="noteText" required></textarea>
                    </div>
                    <div class="field">
                        <label for="note-visibility">Visibility</label>
                        <select id="note-visibility" @bind="isInternal">
                            <option value="true">Internal (staff and management)</option>
                            <option value="false">Public (visible to requester)</option>
                        </select>
                    </div>
                    @if (noteError is not null)
                    {
                        <p class="validation-message" role="alert">@noteError</p>
                    }
                    <div class="form-actions">
                        <button type="submit" class="btn btn-primary">Add note</button>
                    </div>
                </form>
            }
        </div>

        <div class="side-stack">
            <div class="card side-card">
                <h3>Ticket information</h3>
                @if (canChangeStatus)
                {
                    <div class="status-transition-box">
                        <div class="field">
                            <label for="ticket-status">Change status</label>
                            <select id="ticket-status" @bind="requestedStatus" disabled="@(TicketService.GetNextStatus(ticket.Status) is null)">
                                <option value="">Select a status</option>
                                @if (TicketService.GetNextStatus(ticket.Status) is { } nextStatus)
                                {
                                    <option value="@nextStatus">@TicketService.DisplayStatus(nextStatus)</option>
                                }
                            </select>
                        </div>
                        <button type="button" class="btn btn-primary btn-block" disabled="@(string.IsNullOrEmpty(requestedStatus))" @onclick="ChangeStatus">Update status</button>
                        @if (transitionMessage is not null)
                        {
                            <p class="transition-feedback" role="status">@transitionMessage</p>
                        }
                    </div>
                }
                <div class="kv">
                    <span>Reference</span>
                    <strong>#@ticket.Id</strong>
                </div>
                <div class="kv">
                    <span>Category</span>
                    <strong>@ticket.Category</strong>
                </div>
                <div class="kv">
                    <span>Location</span>
                    <strong>@ticket.Location</strong>
                </div>
                <div class="kv">
                    <span>Location Impact</span>
                    <strong>@ticket.ImpactName (@ticket.ImpactLevel)</strong>
                </div>
                <div class="kv">
                    <span>Category Urgency</span>
                    <strong>@ticket.UrgencyName (@ticket.UrgencyLevel)</strong>
                </div>
                <div class="kv">
                    <span>Priority</span>
                    <strong class="badge @PriorityMatrix.GetPriorityBadgeClass(ticket.PriorityId)">@ticket.Priority</strong>
                </div>
                <div class="kv">
                    <span>Status</span>
                    <strong>@ticket.Status</strong>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = "";

    Ticket? ticket;
    string requestedStatus = "";
    string? transitionMessage;
    IReadOnlyList<TicketNote> notes = Array.Empty<TicketNote>();
    string noteText = "";
    string? noteError;
    bool isInternal = true;
    bool canAddNotes;
    bool canChangeStatus;

    private static string GetStatusBadgeClass(string? status) => status switch
    {
        "Open" or "NEW" => "badge-open",
        "Assigned" or "ASSIGNED" => "badge-assigned",
        "In Progress" or "IN_PROGRESS" => "badge-progress",
        "Resolved" or "RESOLVED" => "badge-resolved",
        _ => "badge-closed"
    };

    protected override async Task OnParametersSetAsync()
    {
        ticket = null;
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        ticket = Tickets.FindVisible(Id, user);
        requestedStatus = "";
        transitionMessage = null;
        noteText = "";
        noteError = null;
        isInternal = true;
        notes = Array.Empty<TicketNote>();
        canAddNotes = false;
        canChangeStatus = false;
        if (ticket is not null) await LoadNotes();
    }

    async Task LoadNotes()
    {
        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        var isAuthenticated = user.Identity?.IsAuthenticated == true;
        canAddNotes = isAuthenticated && (user.IsInRole("Staff") || user.IsInRole("Management"));
        canChangeStatus = isAuthenticated && user.IsInRole("Staff");
        notes = Tickets.GetNotes(Id, user);
    }

    async Task AddNote()
    {
        noteError = null;
        if (string.IsNullOrWhiteSpace(noteText))
        {
            noteError = "Enter a note before saving.";
            return;
        }

        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        try
        {
            Tickets.AddNote(Id, noteText, isInternal, user);
            noteText = "";
        }
        catch (Exception ex) when (ex is ArgumentException or UnauthorizedAccessException)
        {
            noteError = ex.Message;
        }
        await LoadNotes();
    }

    async Task ChangeStatus()
    {
        var state = await Authentication.GetAuthenticationStateAsync();
        var result = Tickets.ChangeStatus(Id, requestedStatus, state.User);
        transitionMessage = result.Message;
        if (result.Success)
        {
            requestedStatus = "";
        }
    }
}
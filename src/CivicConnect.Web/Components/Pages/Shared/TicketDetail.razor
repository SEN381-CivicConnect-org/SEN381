@page "/tickets/{Id}"
@attribute [Authorize]
@inject TicketService Tickets
@inject WorkspaceNavigation Workspace

@if (ticket is null)
{
    <PageTitle>Ticket not found | CivicConnect</PageTitle>
    <div class="page-head">
        <div>
            <h1>Ticket not found</h1>
            <p>This ticket is unavailable. Return to your workspace to choose another ticket.</p>
        </div>
    </div>
    <button type="button" class="btn btn-primary" @onclick="Workspace.GoBack">Return to my workspace</button>
}
else
{
    <PageTitle>#@ticket.Id - @ticket.Title | CivicConnect</PageTitle>

    <div class="page-head">
        <div>
            <button class="btn btn-ghost" @onclick="Workspace.GoBack">Back</button>
            <h1 style="margin-top:8px">@ticket.Title</h1>
            <p>#@ticket.Id · @ticket.Category · @ticket.Location</p>
        </div>
        <div style="display: flex; gap: 8px; align-items: center;">
            <span class="badge @PriorityMatrix.GetPriorityBadgeClass(ticket.PriorityId)">@ticket.Priority Priority</span>
            <span class="badge">@ticket.Status</span>
        </div>
    </div>

    <div class="detail-grid">
        <div class="card detail-card">
            <div class="meta-grid">
                <div class="meta-item">
                    <span>Requester</span>
                    <strong>@ticket.Requester</strong>
                </div>
                <div class="meta-item">
                    <span>Assigned to</span>
                    <strong>@ticket.Assignee</strong>
                </div>
                <div class="meta-item">
                    <span>Priority</span>
                    <strong>@ticket.Priority</strong>
                </div>
                <div class="meta-item">
                    <span>Last updated</span>
                    <strong>@ticket.Updated</strong>
                </div>
            </div>

            <!-- FR-05 Priority Calculation Snapshot Breakdown -->
            <div style="margin: 20px 0; padding: 14px 16px; background: var(--surface-subtle, #f8fafc); border: 1px solid var(--border); border-radius: 8px;">
                <div style="font-weight: 600; font-size: 13px; color: var(--text); margin-bottom: 8px; display: flex; justify-content: space-between; align-items: center;">
                    <span>Priority Calculation Snapshot (FR-05 / STK-CFL-01)</span>
                    <span style="font-size: 10.5px; font-weight: normal; color: var(--muted);">PriorityMatrix (DD-02)</span>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; font-size: 12.5px;">
                    <div>
                        <span style="color: var(--muted); display: block;">Location Impact</span>
                        <strong>@ticket.ImpactName Impact (Level @ticket.ImpactLevel)</strong>
                    </div>
                    <div>
                        <span style="color: var(--muted); display: block;">Category Urgency</span>
                        <strong>@ticket.UrgencyName Urgency (Level @ticket.UrgencyLevel)</strong>
                    </div>
                    <div>
                        <span style="color: var(--muted); display: block;">Calculated Priority</span>
                        <strong>@ticket.Priority (Target #@ticket.PriorityId)</strong>
                    </div>
                </div>
            </div>

            <div class="description">
                <strong>Description</strong>
                <p>@ticket.Description</p>
            </div>

            <div class="section-head" style="margin-top:28px">
                <h2>Activity</h2>
            </div>
            <div class="timeline">
                <div class="timeline-item">
                    <div class="dot"></div>
                    <div>
                        <strong>Status: @ticket.Status</strong>
                        <p>@ticket.Updated · System activity</p>
                    </div>
                </div>
                <div class="timeline-item">
                    <div class="dot"></div>
                    <div>
                        <strong>Ticket created with Priority: @ticket.Priority</strong>
                        <p>Request submitted by @ticket.Requester (Impact: @ticket.ImpactName [@ticket.ImpactLevel], Urgency: @ticket.UrgencyName [@ticket.UrgencyLevel]).</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="side-stack">
            <div class="card side-card">
                <h3>Ticket information</h3>
                <div class="kv">
                    <span>Ticket ID</span>
                    <strong>@ticket.Id</strong>
                </div>
                <div class="kv">
                    <span>Category</span>
                    <strong>@ticket.Category</strong>
                </div>
                <div class="kv">
                    <span>Location</span>
                    <strong>@ticket.Location</strong>
                </div>
                <div class="kv">
                    <span>Location Impact</span>
                    <strong>@ticket.ImpactName (@ticket.ImpactLevel)</strong>
                </div>
                <div class="kv">
                    <span>Category Urgency</span>
                    <strong>@ticket.UrgencyName (@ticket.UrgencyLevel)</strong>
                </div>
                <div class="kv">
                    <span>Priority</span>
                    <strong class="badge @PriorityMatrix.GetPriorityBadgeClass(ticket.PriorityId)">@ticket.Priority</strong>
                </div>
                <div class="kv">
                    <span>Status</span>
                    <strong>@ticket.Status</strong>
                </div>
            </div>
        </div>
    </div>
}

@code
{
    [Parameter]
    public string Id { get; set; } = "";

    private Ticket? ticket;

    protected override void OnParametersSet() => ticket = Tickets.Find(Id);
}

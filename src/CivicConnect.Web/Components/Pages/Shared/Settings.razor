@page "/settings"
@attribute [Authorize]
@inject DemoAuthenticationStateProvider Auth

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <p>Profile and email notification settings are read-only in this demo.</p>
    </div>
</div>
<div class="grid grid-2">
    <div class="card settings-card">
        <h3>Notifications</h3>
        <div class="setting-row">
            <div>
                <h4>Email updates</h4>
                <p>Email notifications are not sent in this demo.</p>
            </div>
        </div>
    </div>
    <div class="card settings-card">
        <h3>Profile</h3>
        <div class="field">
            <label for="display-name">Display name</label>
            <input id="display-name" value="@Auth.CurrentUser?.Name" readonly aria-describedby="profile-note" />
            <small id="profile-note">Your signed-in name. Profile editing is not available in this demo.</small>
        </div>
    </div>
</div>

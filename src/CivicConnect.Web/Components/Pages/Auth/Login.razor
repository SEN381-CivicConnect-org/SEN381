@page "/login"
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@inject AppAuthenticationStateProvider Auth
@inject WorkspaceNavigation Workspace

<PageTitle>Sign in | CivicConnect</PageTitle>
<div class="login-page">
    <section class="login-visual">
        <div class="brand">
            <div class="brand-mark">CC</div>
            <div>
                <strong>CivicConnect</strong>
                <span>Service Management</span>
            </div>
        </div>
        <div class="login-copy">
            <h1>One place for every request.</h1>
            <p>Explore a service request workspace with demo tickets and role-based views.</p>
            <ul class="login-feature-list">
                <li>Submit and view demo tickets</li>
                <li>Requester, Staff and Management views</li>
                <li>Sample ticket status and activity</li>
            </ul>
        </div>
        <small class="login-prototype">SEN381 Blazor Prototype</small>
    </section>
    <section class="login-panel">
        <div class="login-theme-toggle">
            <ThemeToggle />
        </div>
        <div class="login-box">
            <h2>Welcome back</h2>
            <p>Sign in to continue to your workspace.</p>
            <div class="field">
                <label>Email address</label>
                <input @bind="email" type="email" />
            </div>
            <div class="field">
                <label>Password</label>
                <input @bind="password" type="password" @onkeydown="HandleKey" />
            </div>
            @if (!string.IsNullOrWhiteSpace(error))
            {
                <p class="login-error">@error</p>
            }
            <button class="btn btn-primary" @onclick="SignIn">Sign in</button>
            <div class="demo-note">
                <p>
                    <strong>Demo accounts</strong>
                </p>
                <p>Requester: requester@civicconnect.demo</p>
                <p>Staff: staff@civicconnect.demo</p>
                <p>Management: manager@civicconnect.demo</p>
                <p>Password for all three: <strong>password</strong></p>
            </div>
        </div>
    </section>
</div>

@code
{
    [SupplyParameterFromQuery(Name = "returnUrl")]
    public string? ReturnUrl { get; set; }

    string email = "requester@civicconnect.demo";
    string password = "password";
    string? error;

    async Task SignIn()
    {
        if (!await Auth.SignInAsync(email, password))
        {
            error = "Incorrect email address or password.";
            return;
        }

        error = null;
        Nav.NavigateTo(Workspace.AfterSignIn(ReturnUrl), replace: true);
    }

    async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SignIn();
        }
    }
}

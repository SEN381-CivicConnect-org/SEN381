@inherits LayoutComponentBase
@implements IDisposable
@using System.Security.Claims
@using CivicConnect.Web.Components.Shared
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web

@if (IsAuthRoute)
{
    @Body
}
else
{
    <div class="@AppShellCssClass" @onkeydown="HandleKey">
        <NavMenu @ref="navigation" />
        <main class="main">
            <header class="topbar">
                <button
                    @ref="menuButton"
                    type="button"
                    class="icon-btn mobile-menu-toggle"
                    aria-label="@MenuToggleAriaLabel"
                    aria-expanded="@MenuToggleAriaExpanded"
                    aria-controls="workspace-navigation"
                    @onclick="ToggleMenu">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <label class="search">
                    <img class="icon" src="assets/icons/search.svg" alt="" />
                    <input readonly aria-label="Search unavailable in this demo" placeholder="Search unavailable" />
                </label>
                <div class="top-actions">
                    <ThemeToggle />
                    <AuthorizeView Context="auth">
                        <Authorized>
                            <div class="profile-chip">
                                <span class="avatar">@Initials(auth.User.Identity?.Name)</span>
                                <span class="profile-text">
                                    <strong>@auth.User.Identity?.Name</strong>
                                    <small>@GetUserRole(auth.User)</small>
                                </span>
                            </div>
                        </Authorized>
                    </AuthorizeView>
                </div>
            </header>
            <section class="content">@Body</section>
        </main>
    </div>
}

@code
{
    private bool menuOpen;
    private bool focusNavigation;
    private NavMenu? navigation;
    private ElementReference menuButton;

    private bool IsAuthRoute =>
        Nav.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase) ||
        Nav.Uri.Contains("/signup", StringComparison.OrdinalIgnoreCase);

    private string AppShellCssClass => menuOpen ? "app-shell menu-open" : "app-shell";

    private string MenuToggleAriaLabel => menuOpen ? "Close workspace menu" : "Open workspace menu";

    private string MenuToggleAriaExpanded => menuOpen ? "true" : "false";

    protected override void OnInitialized() => Nav.LocationChanged += CloseOnNavigation;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
        focusNavigation = menuOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusNavigation && navigation is not null)
        {
            focusNavigation = false;
            await navigation.FocusNavigationAsync();
        }
    }

    private void CloseOnNavigation(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(() =>
    {
        menuOpen = false;
        StateHasChanged();
    });

    private async Task HandleKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && menuOpen)
        {
            menuOpen = false;
            await menuButton.FocusAsync();
        }
    }

    public void Dispose() => Nav.LocationChanged -= CloseOnNavigation;

    private static string? GetUserRole(ClaimsPrincipal user) =>
        user.FindFirst(ClaimTypes.Role)?.Value;

    private static string Initials(string? name) => string.IsNullOrWhiteSpace(name)
        ? "CC"
        : string.Join(string.Empty, name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(x => x[0])).ToUpperInvariant();
}

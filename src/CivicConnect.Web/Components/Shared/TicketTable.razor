<div class="card table-wrap"><table><thead><tr><th>Ticket</th><th>Category</th><th>Priority</th><th>Status</th><th>Last updated</th></tr></thead><tbody>@foreach(var t in Tickets){<tr class="clickable" @onclick='()=>Nav.NavigateTo($"/tickets/{t.Id}")'><td><span class="ticket-title">@t.Title</span><span class="ticket-sub">#@t.Id</span></td><td>@t.Category</td><td><span class="badge @Priority(t.Priority)">@t.Priority</span></td><td><span class="badge @Status(t.Status)">@t.Status</span></td><td>@t.Updated</td></tr>}</tbody></table></div>
@code{[Parameter] public IEnumerable<Ticket> Tickets {get;set;}=[]; string Status(string s)=>s switch{"Open"=>"badge-open","In Progress"=>"badge-progress","Resolved"=>"badge-resolved",_=>"badge-closed"}; string Priority(string s)=>s switch{"High"=>"badge-high","Medium"=>"badge-medium",_=>"badge-low"};}

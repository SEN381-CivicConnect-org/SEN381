# ==============================================================================
# CivicConnect Environment Variables Configuration Template
# Standard: SEN381 NFR-01 (No secrets in source control / Strict Environment Parity)
#
# INSTRUCTIONS:
# Copy this file to '.env' for local Docker compose execution:
#   cp .env.example .env
# Replace placeholder values with environment-specific credentials.
# ==============================================================================

# PostgreSQL Relational Persistence Configuration
POSTGRES_DB=civicconnect
POSTGRES_USER=civicconnect
POSTGRES_PASSWORD=civicconnect_secure_dev_pass
POSTGRES_PORT=5432

# Dedicated Database Roles & Credentials (NFR-10: Separation of Duties)
CIVIC_APP_USER=civic_app
CIVIC_APP_PASSWORD=civic_app_secure_dev_pass
CIVIC_MIGRATE_USER=civic_migrate
CIVIC_MIGRATE_PASSWORD=civic_migrate_secure_pass
CIVIC_REPORT_USER=civic_report
CIVIC_REPORT_PASSWORD=civic_report_secure_pass

# RabbitMQ Message Broker Configuration
RABBITMQ_DEFAULT_USER=civicconnect
RABBITMQ_DEFAULT_PASS=rabbit_secure_dev_pass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# Application Service Ports
BACKEND_PORT=5060
FRONTEND_PORT=8085

# Internal Network Connection Strings (Containers communicate via service names on civicconnect-net)
# Application Runtime Connection String (NFR-10: least-privilege role civic_app)
CONNECTION_STRING=Host=db;Port=5432;Database=civicconnect;Username=civic_app;Password=civic_app_secure_dev_pass;SslMode=Require

# Migration Pipeline Connection String (NFR-10: dedicated DDL role civic_migrate)
MIGRATION_CONNECTION_STRING=Host=db;Port=5432;Database=civicconnect;Username=civic_migrate;Password=civic_migrate_secure_pass;SslMode=Require

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

# Application Security & JWT Authentication Secrets (NFR-01)
JWT_SECRET=civicconnect_dev_jwt_secret_key_min_32_bytes_long

# Durability, Backup Schedule & POPIA Retention Configuration (NFR-02, NFR-05)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE_INTERVAL_SECONDS=86400
WAL_ARCHIVE_TIMEOUT=900

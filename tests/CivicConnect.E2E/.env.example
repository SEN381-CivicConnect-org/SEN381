# Copy to .env and supply local values. No credentials are provided or auto-loaded.
E2E_BASE_URL=http://localhost:8085
E2E_STAFF_EMAIL=
E2E_STAFF_PASSWORD=
E2E_REQUESTER_A_EMAIL=
E2E_REQUESTER_A_PASSWORD=
E2E_REQUESTER_B_EMAIL=
E2E_REQUESTER_B_PASSWORD=
E2E_SEARCH_KEYWORD=Wi-Fi
E2E_SEARCH_MATCH_TITLE='Unable to connect to office Wi-Fi'
E2E_SEARCH_NONMATCH_TITLE='New starter system access'
E2E_REQUESTER_A_TICKET_ID=CC-014
E2E_REQUESTER_A_TICKET_TITLE='Unable to connect to office Wi-Fi'
E2E_REQUESTER_B_TICKET_ID=CC-010
E2E_REQUESTER_B_TICKET_TITLE='New starter system access'
E2E_WORKFLOW_TICKET_TITLE='New starter system access'
# Display label of the next forward transition, e.g. Assigned
E2E_WORKFLOW_NEXT_STATUS=Assigned
# Required by specs/auth.spec.js for the Management regression check.
E2E_MANAGEMENT_EMAIL=
E2E_MANAGEMENT_PASSWORD=
# Exact visible labels for Staff Queue filter tests.
E2E_QUEUE_CATEGORY=Facilities
E2E_QUEUE_STATUS=Open

# Optional request-creation UI choices (defaults shown).
E2E_CREATE_CATEGORY=Facilities
E2E_CREATE_LOCATION='Ground Floor'
